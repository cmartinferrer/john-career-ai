# Google Gemini API key
# Get your API key at https://aistudio.google.com/
GOOGLE_API_KEY=replace-with-your-api-key

# Interface language: es or en
CAREER_AI_LOCALE=es

# Gemini model
# Example: gemini-3.5-flash-lite (check current availability)
GEMINI_MODEL=replace-with-your-model

# Maximum requests per visitor within the configured time window
MAX_REQUESTS=20

# Rate limit window in seconds (3600 = 1 hour)
RATE_LIMIT_WINDOW_SECONDS=3600

# Maximum total requests per day (0 = disabled)
GLOBAL_DAILY_REQUEST_LIMIT=200